<Window x:Class="Hearm.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hearm" Height="510" Width="470" MinHeight="480" MinWidth="420" WindowStartupLocation="CenterScreen" Background="#F4F3ED">
  <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="3" Height="9" CornerRadius="2" Background="#607C54" Margin="0,0,3,0" VerticalAlignment="Center"/><Border Width="3" Height="16" CornerRadius="2" Background="#607C54" Margin="0,0,3,0" VerticalAlignment="Center"/><Border Width="3" Height="23" CornerRadius="2" Background="#607C54" Margin="0,0,3,0" VerticalAlignment="Center"/><Border Width="3" Height="12" CornerRadius="2" Background="#607C54" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="hearm" FontSize="25" FontWeight="Bold" Foreground="#222820"/></StackPanel><TextBlock Text="Your laptop audio, on your phone." Margin="0,5,0,0" Foreground="#778071"/></StackPanel>
    <Border Grid.Row="1" Margin="0,27,0,20" Background="White" CornerRadius="12" Padding="22"><StackPanel VerticalAlignment="Center"><TextBlock Text="SHARE THE WHOLE LAPTOP MIX" FontSize="10" FontWeight="Bold" Foreground="#818679"/><TextBlock Text="YouTube, Spotify, games, calls — the sound from your Windows output is sent live to the phone." TextWrapping="Wrap" FontSize="14" LineHeight="22" Margin="0,12,0,18" Foreground="#50564C"/><TextBlock Text="PHONE CONNECTION ADDRESS" FontSize="9" FontWeight="Bold" Foreground="#96998F"/><Border Background="#F7F8F4" CornerRadius="5" Padding="12" Margin="0,7,0,8"><TextBlock x:Name="AddressText" FontFamily="Consolas" FontSize="12" Foreground="#526849" TextWrapping="Wrap"/></Border><TextBlock Text="Enter this address in Hearm on your Android phone. Both devices need the same Wi-Fi." TextWrapping="Wrap" FontSize="10" Foreground="#858A80"/><Button x:Name="StartButton" Content="Start sharing laptop audio" Click="StartButton_Click" Height="44" Margin="0,22,0,0" Background="#607C54" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/><Button x:Name="StopButton" Content="Stop sharing" Click="StopButton_Click" Height="38" Margin="0,8,0,0" Background="#F7F8F4" Foreground="#626A5D" BorderThickness="0" IsEnabled="False"/><TextBlock x:Name="StatusText" Text="Ready" Margin="0,12,0,0" FontSize="10" Foreground="#858A80"/></StackPanel></Border>
    <TextBlock Grid.Row="2" Text="Audio stays on your local network. Keep this window open." FontSize="9" Foreground="#96998F" HorizontalAlignment="Center"/>
  </Grid>
</Window>
